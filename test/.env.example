# Copy to .env.local (gitignored) and edit.
#
# There is only one thing to point at: the document server. Every route the app
# fetches — /markdown, /tiles, /events and /assignment/* — is served by that one
# origin. The lookcam assignment reader is reached by the document server, not
# by this app, so its URL and token are never configured here.

# ── dev: npm run dev ─────────────────────────────────────────────────────────
# Where Vite proxies the document routes. The proxy exists because the
# simulator's webview refuses to open a cross-origin EventSource — going
# through Vite makes those requests same-origin.
#
#   deployed VPS            https://even.aansl.com
#   server on this machine  http://localhost:8787
#   server elsewhere on LAN http://192.168.0.117:8787
#
# `npm run dev:local` overrides this with localhost for a one-off.
VITE_MD_TARGET=https://even.aansl.com

# ── packed / hardware build: npm run build && npm run pack ───────────────────
# A packed bundle has no Vite, so the app needs an absolute URL compiled in.
# Leave this unset for dev builds: unset means same-origin, which is exactly
# what the proxy above provides. The document server sends permissive CORS, so
# a cross-origin absolute URL works here.
# VITE_MD_SERVER=https://even.aansl.com
