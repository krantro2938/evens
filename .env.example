# Copy to .env for `docker compose up -d`.
#
# ADDING A NAME HERE IS NOT ENOUGH. docker-compose.yml enumerates the container's
# environment explicitly instead of using `env_file`, so a variable that exists
# only in this file is read during substitution and never reaches the server.
# The failure is quiet and convincing: the process boots, reports the feature as
# unconfigured, and the .env in front of you plainly configures it. Add every new
# name to the `environment:` block too.

# The lookcam assignment reader. On the shared compose network this is the
# container name, not the public vhost — leave it alone unless the reader runs
# somewhere else, in which case use https://assignment.<your-domain>.
ASSIGNMENT_URL=http://assignment:8091

# REQUIRED. Must match ASSIGNMENT_TOKEN in the lookcam stack's vps/docker/.env,
# or every assignment route answers 401.
ASSIGNMENT_TOKEN=

# How long to wait for the reader to stop changing before re-rendering tiles.
# Tile rendering is the expensive step, so this keeps a burst of captures from
# queueing a render each.
ASSIGNMENT_DEBOUNCE_MS=2000

# ── the solve loop ───────────────────────────────────────────────────────────
# The AI page's trigger button hands the assignment to a Claude routine and
# shows whatever markdown it posts back. Two credentials are involved and they
# do different jobs.

# REQUIRED. The routine's shared secret: it presents this to GET
# /solution/claim, which hands back the assignment text plus a one-time token
# for submitting the answer. Put the same value in the routine's prompt.
#   openssl rand -hex 24
# Leave it empty and /solution/claim is unauthenticated — on a public vhost that
# means anyone can pull your assignment and push a "solution" to your glasses.
SOLVER_TOKEN=

# REQUIRED IF YOU WANT MESSAGES. The camera web app's shared secret for POST
# /messages — the route that puts text on the glasses. Must match MESSAGE_TOKEN
# in the lookcam stack's vps/docker/.env, which is the only thing that should
# ever hold it.
#   openssl rand -hex 24
# Leave it empty and POST /messages is unauthenticated: anyone who can reach
# this vhost can write to your glasses. Every OTHER message route is open by
# design — the glasses ship as a packed app and cannot hold a secret, which is
# the same trade /solution/status and /solve already make.
MESSAGE_TOKEN=

# ── triggering the routine on demand (optional) ──────────────────────────────
# Without these, a tap still works: the run is queued for whatever drains it
# (routine/runner.sh, or the routine's own schedule). Set them and a tap starts
# a cloud session within seconds.
#
# Both come from the routine's API trigger at https://claude.ai/code/routines →
# your routine → pencil → Select a trigger → Add another trigger → API. The
# token is shown once, on generation.
#
# It is scoped to firing that one routine, so unlike a claude.ai session
# credential it is a reasonable thing to keep in a .env. Rotate it in the same
# modal.
#
# THE ROUTINE ALSO NEEDS TO REACH THIS SERVER. A cloud environment defaults to
# "Trusted" network access, which blocks every domain outside the package
# registries — the routine's first request then fails with 403
# host_not_allowed and nothing happens. In the same edit form, open the
# environment settings and set Network access to Custom with your domain (e.g.
# even.aansl.com) in Allowed domains.
ROUTINE_ID=
ROUTINE_TOKEN=

# How long a claimed run may go without submitting before it counts as failed.
# Long enough for a slow model on a long paper; short enough that a crashed
# agent doesn't leave the glasses saying "solving" all evening.
SOLVE_TIMEOUT_MS=1200000

# ── the review loop (optional) ───────────────────────────────────────────────
# A SECOND routine that grades what the first one wrote and sends the problems
# that fall short back to be solved again. Without REVIEW_ROUTINE_ID nothing is
# graded and this server behaves exactly as it did before the loop existed.
#
# It is a separate routine, not a second mode of the solver, because the two
# jobs have different economics: the solver can be Sonnet on an easy paper, and
# the grader should be Opus — its whole value is catching what a good model
# missed. A routine's model is a property of the routine, so they have to be two.
#
# Same setup as above and the same two silent failure modes: the routine needs a
# repository selected AND its environment's network access set to Custom with
# this server's domain allowed. Its prompt is routine/review.md — paste
# `./routine/render-prompt.sh review`, never the file.
REVIEW_ROUTINE_ID=
# Optional: defaults to ROUTINE_TOKEN, since one API trigger can be reused
# across two routines in the same account.
REVIEW_ROUTINE_TOKEN=

# Grades nothing while leaving the routine configured. For turning the loop off
# without unpicking the setup.
REVIEW_ENABLED=1

# THE RUBRIC. Here rather than in the prompt so the thresholds live in one place
# and the reviewer cannot reason its way around them: it reports points, this
# server decides what they mean.
#
# The first REVIEW_ANSWER_BAND problems are graded on the final answer alone and
# go back if it is wrong, whatever they scored. Everything after them is graded
# on the working, and goes back below REVIEW_METHOD_PASS — so a right answer
# with an unargued middle (5 of 18) is re-solved, and a well-argued attempt that
# slipped in the arithmetic can pass. That asymmetry is the point of the loop.
REVIEW_ANSWER_BAND=3
REVIEW_ANSWER_MAX=15
REVIEW_METHOD_MAX=18
REVIEW_METHOD_ANSWER_POINTS=5
REVIEW_METHOD_PASS=13

# Total attempts at any one problem, the first pass included. THE ONLY THING
# BOUNDING WHAT THIS LOOP SPENDS — every round is one solver session and one
# reviewer session, and a problem the two disagree about permanently would
# otherwise run forever.
REVIEW_MAX_ROUNDS=3

# How long a claimed review may go without submitting before it counts as
# failed. Same job as SOLVE_TIMEOUT_MS, for the grader.
REVIEW_TIMEOUT_MS=1200000

# ── the assignment as images (optional) ──────────────────────────────────────
# /assignment/sheet.png renders the transcription as one tall PNG for reading
# and downloading (the camera site's Assignment tab). 576px wide is a HUD, not a
# document, so the download is rastered denser. Page images are always 1:1 —
# they are a pixel-exact picture of the glasses display and are not affected.
SHEET_SCALE=2
